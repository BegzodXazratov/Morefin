{
  "cleanUrls": true,
  "redirects": [
    { "source": "/baholash", "destination": "/baholash/", "permanent": false },
    { "source": "/taklif", "destination": "/taklif/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "functions": {
    "api/broadcast.js": { "maxDuration": 60 },
    "api/cron.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 5 * * *" }
  ]
}
